# PostgreSQL connection string (T002)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mini_library?schema=public"

# Secret used to sign/encrypt session cookies (P002, T005)
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Runtime environment: development | test | production
NODE_ENV="development"

# docker-compose.yml only: PostgreSQL password for the db container
DB_PASSWORD="replace-with-a-strong-db-password"

# Secret header value for POST /api/internal/crash (demo). Empty = endpoint disabled.
CRASH_TOKEN=""
